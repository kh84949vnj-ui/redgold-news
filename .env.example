# Copy to .env and fill in. .env is in .gitignore and must never be committed.

# The National Weather Service asks API users to identify themselves in the
# User-Agent. Put a contact here (a school email or website), not a personal one.
NWS_CONTACT=

# Optional overrides
# RGN_LAT=26.2470
# RGN_LON=-98.4814

# Writing into the weekly Google Doc (see gdoc/README.md).
# The web app URL from Deploy > New deployment, and the same token that is in gdoc/Code.gs.
RGN_GDOC_URL=
RGN_GDOC_TOKEN=
